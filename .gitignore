# Credentials / service-account keys — never commit these.
# Patterns without a slash match at every depth, so these cover the repo root
# AND any subdirectory (backend/, etc.).
client_secrets.json
client_secret.json
gcp-service-account.json
serviceAccountKey.json
*-service-account*.json

# Python caches
__pycache__/
*.py[cod]

# Node
node_modules/

# TypeScript incremental build cache — regenerated on every compile.
frontend/tsconfig.tsbuildinfo

# Env backups and retired credential files — never commit, even when "legacy".
# Note *-service-account*.json did NOT match gcp-service-account.json.edu-prod-legacy,
# because that pattern requires the name to end in .json.
.env.*
!.env.example
*.edu-prod-legacy
*.backup-*
*-legacy
*.legacy
.firebase/

# Renamed-aside credential files. `*-service-account*.json` requires the name to
# END in .json, so parking a key as `gcp-service-account.json.bak` slipped past
# every rule above and would have been committed by `git add -A`.
*.bak

# Local dev server logs.
*.log
